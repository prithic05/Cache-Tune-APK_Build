# Database
POSTGRES_USER=cachetune
POSTGRES_PASSWORD=cachetune
POSTGRES_DB=cachetune_db
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
CREDENTIAL_ENCRYPTION_KEY=generate_a_32_byte_base64_url_safe_key_here

# Mail / OTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
OTP_EXPIRY_SECONDS=600

# Session
SESSION_MAX_AGE=2592000

# Paths & Cleanup
DOWNLOAD_DIR=./downloads
CACHE_CLEANUP_INTERVAL=1200
